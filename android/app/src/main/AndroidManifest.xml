<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.novax.agent">

    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications (required at runtime on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service: keeps the agent's voice session alive when the
         app is backgrounded (e.g. mid-listen). Android 14+ requires a
         declared type; we use "microphone" since that's this app's real use. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Camera is optional; only requested if/when takePhoto() is wired up
         to a real capture flow (not implemented yet — see NovaXBridge.kt). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="NovaX"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.NovaX"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NovaXForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
